cff-version: 1.2.0
message: >-
  CyberShake.jl is only a Julia interface. If you use it, please cite the CyberShake paper
  and the cybershake-core software that does the actual computations.
title: CyberShake.jl
type: software
authors:
  - family-names: Kaus
    given-names: Boris
    email: kaus@uni-mainz.de
repository-code: https://github.com/boriskaus/CyberShake.jl
license: MIT
references:
  - type: article
    title: "CyberShake: A Physics-Based Seismic Hazard Model for Southern California"
    authors:
      - family-names: Graves
        given-names: Robert
      - family-names: Jordan
        given-names: Thomas H.
      - family-names: Callaghan
        given-names: Scott
      - name: et al.
    journal: Pure and Applied Geophysics
    volume: 168
    start: 367
    end: 381
    year: 2011
    doi: 10.1007/s00024-010-0161-6
    notes: SCEC Contribution 1354
  - type: software
    title: "cybershake-core"
    authors:
      - name: Southern California Earthquake Center
    repository-code: https://github.com/SCECcode/cybershake-core
    license: BSD-3-Clause
